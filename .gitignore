__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Runtime output (per-session data, not source)
logs/**/*.jsonl
logs/**/*.zip
snapshots/**/*.json
snapshots/**/*.zip
!snapshots/.gitkeep
!logs/.gitkeep

*.onnx
.DS_Store

# License signing key(s) -- the private half must NEVER be committed or
# shipped. Only app/licensing/public_key.py (the public half) is tracked.
secrets/

# PyInstaller build output
build/
dist/
*.spec.bak
# Firebase service-account (admin SDK) keys -- REAL secrets, never commit.
# Glob catches any regenerated key regardless of its random suffix.
*firebase-adminsdk*.json
serviceAccountKey.json
